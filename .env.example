# Copia este ficheiro para .env e preenche com os teus valores.
# O .env nunca deve ser commitado (já está no .gitignore).

# Supabase: Project Settings → API (Project URL + anon public key)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Cloudflare Turnstile: site key do widget (a secret key só vive na edge function)
# Chave de teste (passa sempre, para dev local): 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
